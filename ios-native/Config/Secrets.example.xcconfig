// 복사해서 Config/Secrets.xcconfig 로 저장하고 값을 채우세요 (Secrets.xcconfig 는 git 에 올라가지 않아요).
// xcconfig 에서는 // 가 주석이라 URL 은 https:/$()/host 형태로 적어야 해요.
//
// SUPABASE_URL / SUPABASE_ANON_KEY 는 웹 앱의 NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY 와 같은 값이에요
// (anon key 는 브라우저에도 내려가는 공개 키예요. service role key 는 절대 넣지 마세요).
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
// AI(/api/ai/assistant)와 쿠팡 구매하기 리다이렉트가 있는 웹 서버
API_BASE_URL = https:/$()/ourhomemenu.vercel.app
